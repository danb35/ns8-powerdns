{"$schema":"http://json-schema.org/draft-07/schema#","title":"update-zone input","$id":"http://schema.nethserver.org/powerdns/update-zone-input.json","description":"Change DNSSEC settings and SOA overrides of a zone","type":"object","required":["zone"],"additionalProperties":false,"properties":{"zone":{"type":"string","minLength":1,"description":"Zone name, like example.com"},"dnssec":{"type":"boolean"},"denial":{"type":"string","enum":["nsec3","nsec"],"description":"NSEC3 with RFC 9276 parameters (default), or plain NSEC"},"soa_refresh":{"type":"integer","minimum":1},"soa_retry":{"type":"integer","minimum":1},"soa_expire":{"type":"integer","minimum":1},"soa_minimum":{"type":"integer","minimum":1}}}
