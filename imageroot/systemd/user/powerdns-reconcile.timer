# Catalog members need their transfer key set (DESIGN 6.2), and a primary copy
# leaves standby when the other primary is gone (DESIGN 10).
[Unit]
Description=Reconcile PowerDNS replication state every minute

[Timer]
OnBootSec=1min
OnUnitActiveSec=1min
# The default of 1min lets the runs drift to two minutes apart
AccuracySec=5s

[Install]
WantedBy=timers.target
