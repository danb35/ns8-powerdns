# Run by powerdns-reconcile.timer. See nsplatform.reconcile().

import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), '..', 'pypkg'))

import agent

from pdnsmodule import core, nsplatform
from pdnsmodule.pdnsapi import ApiError

try:
    nsplatform.reconcile()
except (OSError, ApiError, core.ActionError) as e:
    # Something is down right now: the next run tries again.
    print(agent.SD_WARNING + 'powerdns: reconcile: %s' % e, file=sys.stderr)
