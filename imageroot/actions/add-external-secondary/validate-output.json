{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "add-external-secondary output",
    "$id": "http://schema.nethserver.org/powerdns/add-external-secondary-output.json",
    "description": "The new peer, and its TSIG key when it uses one",
    "type": "object",
    "required": [
        "secondary"
    ],
    "additionalProperties": false,
    "properties": {
        "secondary": {
            "type": "object",
            "required": [
                "id",
                "name",
                "notify",
                "auth",
                "tsig_key",
                "transfer_from",
                "ns_names",
                "advertise",
                "zones"
            ],
            "properties": {
                "id": {
                    "type": "string"
                },
                "name": {
                    "type": "string"
                },
                "notify": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "auth": {
                    "type": "string"
                },
                "tsig_key": {
                    "type": "string"
                },
                "transfer_from": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "ns_names": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "advertise": {
                    "type": "boolean"
                },
                "zones": {
                    "oneOf": [
                        {
                            "type": "string"
                        },
                        {
                            "type": "array",
                            "items": {
                                "type": "string"
                            }
                        }
                    ]
                }
            }
        },
        "key": {
            "type": "object",
            "required": [
                "key_name",
                "algorithm",
                "secret"
            ],
            "additionalProperties": false,
            "properties": {
                "key_name": {
                    "type": "string"
                },
                "algorithm": {
                    "type": "string"
                },
                "secret": {
                    "type": "string"
                }
            }
        }
    }
}
