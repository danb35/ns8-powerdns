{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "add-zone input",
    "$id": "http://schema.nethserver.org/powerdns/add-zone-input.json",
    "description": "Create a zone on the primary",
    "type": "object",
    "required": [
        "zone"
    ],
    "additionalProperties": false,
    "properties": {
        "zone": {
            "type": "string",
            "minLength": 1,
            "description": "Zone name, like example.com"
        },
        "dnssec": {
            "type": "boolean"
        },
        "denial": {
            "type": "string",
            "enum": [
                "nsec3",
                "nsec"
            ],
            "description": "NSEC3 with RFC 9276 parameters (default), or plain NSEC"
        },
        "soa_refresh": {
            "type": "integer",
            "minimum": 1
        },
        "soa_retry": {
            "type": "integer",
            "minimum": 1
        },
        "soa_expire": {
            "type": "integer",
            "minimum": 1
        },
        "soa_minimum": {
            "type": "integer",
            "minimum": 1
        }
    }
}
