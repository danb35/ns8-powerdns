{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "add-zone output",
    "$id": "http://schema.nethserver.org/powerdns/add-zone-output.json",
    "description": "Create a zone on the primary",
    "type": "object",
    "required": [
        "zone",
        "glue"
    ],
    "additionalProperties": false,
    "properties": {
        "zone": {
            "type": "string"
        },
        "glue": {
            "type": "array",
            "description": "NS names inside the zone: the registrar needs glue for them",
            "items": {
                "type": "object",
                "required": [
                    "ns_name",
                    "addresses"
                ],
                "properties": {
                    "ns_name": {
                        "type": "string"
                    },
                    "addresses": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    }
                }
            }
        }
    }
}
