import os
import sys

sys.path.insert(0, os.path.join(os.environ['AGENT_INSTALL_DIR'], 'pypkg'))

import agent
import agent.tasks

from pdnsmodule import actions

if not actions.config.env().get('POWERDNS_ROLE'):
    sys.exit(0)  # the backup was taken before the first configuration

response = agent.tasks.run('module/' + os.environ['MODULE_ID'], action='configure-module',
                           data=actions.restore_configure_data())
agent.assert_exp(response['exit_code'] == 0)
