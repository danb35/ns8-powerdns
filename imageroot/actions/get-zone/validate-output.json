{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "get-zone output",
    "$id": "http://schema.nethserver.org/powerdns/get-zone-output.json",
    "description": "One zone, with DS records on a primary",
    "type": "object",
    "required": [
        "zone",
        "kind",
        "serial",
        "dnssec",
        "ds_records"
    ],
    "properties": {
        "zone": {
            "type": "string"
        },
        "kind": {
            "type": "string"
        },
        "serial": {
            "type": "integer"
        },
        "dnssec": {
            "type": "boolean"
        },
        "denial": {
            "type": [
                "string",
                "null"
            ]
        },
        "ds_records": {
            "type": "array",
            "description": "SHA-256 DS records for the registrar",
            "items": {
                "type": "string"
            }
        },
        "glue": {
            "type": "array",
            "description": "NS names inside the zone: the registrar needs glue for them",
            "items": {
                "type": "object",
                "required": [
                    "ns_name",
                    "addresses"
                ],
                "properties": {
                    "ns_name": {
                        "type": "string"
                    },
                    "addresses": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    }
                }
            }
        }
    }
}
