{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "get-records output",
    "$id": "http://schema.nethserver.org/powerdns/get-records-output.json",
    "description": "Records of a zone, and whether this module may edit them",
    "type": "object",
    "required": [
        "zone",
        "records",
        "managed_by_dnshelper",
        "dnshelper_module_id",
        "editable"
    ],
    "additionalProperties": false,
    "properties": {
        "zone": {
            "type": "string"
        },
        "records": {
            "type": "array",
            "items": {
                "type": "object",
                "required": [
                    "name",
                    "type",
                    "ttl",
                    "data"
                ],
                "additionalProperties": false,
                "properties": {
                    "name": {
                        "type": "string",
                        "minLength": 1,
                        "description": "Name relative to the zone, '@' for the apex"
                    },
                    "type": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9]+$"
                    },
                    "ttl": {
                        "type": "integer",
                        "minimum": 0,
                        "description": "Seconds; 0 or absent keeps 3600"
                    },
                    "data": {
                        "type": "string",
                        "description": "RDATA in unescaped zone-file syntax. TXT: the whole plain value, unquoted"
                    }
                }
            }
        },
        "managed_by_dnshelper": {
            "type": "boolean"
        },
        "dnshelper_module_id": {
            "type": "string"
        },
        "editable": {
            "type": "boolean"
        }
    }
}
