{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "check-zone-ds input",
    "$id": "http://schema.nethserver.org/powerdns/check-zone-ds-input.json",
    "description": "Ask a public resolver whether the parent publishes a DS. Informational",
    "type": "object",
    "required": [
        "zone"
    ],
    "additionalProperties": false,
    "properties": {
        "zone": {
            "type": "string",
            "minLength": 1,
            "description": "Zone name, like example.com"
        }
    }
}
