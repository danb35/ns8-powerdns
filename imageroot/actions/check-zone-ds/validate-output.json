{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "check-zone-ds output",
    "$id": "http://schema.nethserver.org/powerdns/check-zone-ds-output.json",
    "description": "Ask a public resolver whether the parent publishes a DS. Informational",
    "type": "object",
    "required": [
        "zone",
        "published",
        "resolver"
    ],
    "additionalProperties": false,
    "properties": {
        "zone": {
            "type": "string"
        },
        "published": {
            "type": [
                "boolean",
                "null"
            ],
            "description": "null when no public resolver answered"
        },
        "resolver": {
            "type": "string"
        }
    }
}
