{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "update-external-secondary input",
    "$id": "http://schema.nethserver.org/powerdns/update-external-secondary-input.json",
    "description": "Change a secondary outside the cluster; fields left out keep their value",
    "type": "object",
    "required": [
        "id"
    ],
    "additionalProperties": false,
    "properties": {
        "id": {
            "type": "string",
            "minLength": 1
        },
        "name": {
            "type": "string",
            "minLength": 1,
            "description": "A label for the UI"
        },
        "notify": {
            "type": "array",
            "minItems": 1,
            "items": {
                "type": "string",
                "minLength": 1
            },
            "description": "Addresses to send NOTIFY to"
        },
        "auth": {
            "type": "string",
            "enum": [
                "tsig",
                "ip"
            ],
            "description": "TSIG key (default), or source addresses only"
        },
        "transfer_from": {
            "type": "array",
            "items": {
                "type": "string",
                "minLength": 1
            },
            "description": "With auth ip: the addresses or networks the peer transfers from"
        },
        "ns_names": {
            "type": "array",
            "items": {
                "type": "string",
                "minLength": 1
            },
            "description": "The peer's name servers"
        },
        "advertise": {
            "type": "boolean",
            "description": "List ns_names in the apex NS of the zones it receives"
        },
        "zones": {
            "oneOf": [
                {
                    "type": "string",
                    "enum": [
                        "all"
                    ]
                },
                {
                    "type": "array",
                    "items": {
                        "type": "string",
                        "minLength": 1
                    }
                }
            ],
            "description": "all, including zones added later, or a list of zones"
        },
        "tsig": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "algorithm": {
                    "type": "string",
                    "enum": [
                        "hmac-md5",
                        "hmac-sha1",
                        "hmac-sha224",
                        "hmac-sha256",
                        "hmac-sha384",
                        "hmac-sha512"
                    ]
                },
                "key_name": {
                    "type": "string",
                    "description": "Defaults to powerdns-<id>"
                },
                "secret": {
                    "type": "string",
                    "description": "Base64 secret issued by the provider; generated when empty"
                },
                "regenerate": {
                    "type": "boolean",
                    "description": "Replace the key with a new generated one"
                }
            }
        }
    }
}
